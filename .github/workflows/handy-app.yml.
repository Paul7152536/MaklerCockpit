# MaklerCockpit Handy - App bauen (v2)
# Startet automatisch, sobald eine neue Projekt-ZIP hochgeladen wird.
# Zusaetzlich von Hand startbar: Actions -> Handy-App bauen -> Run workflow
name: Handy-App bauen

on:
  push:
    paths:
      - '**.zip'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  bauen:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Neueste Projekt-ZIP suchen und entpacken
        run: |
          ZIP=$(find . -path ./.git -prune -o -type f -iname 'MaklerCockpit-Handy-v*-Projekt*.zip' -print | sort -V | tail -1)
          if [ -z "$ZIP" ]; then ZIP=$(find . -path ./.git -prune -o -type f -iname '*.zip' -print | sort -V | tail -1); fi
          if [ -z "$ZIP" ]; then echo "Keine ZIP gefunden - bitte MaklerCockpit-Handy-vX-Projekt.zip hochladen"; exit 1; fi
          echo "Entpacke: $ZIP"
          rm -rf /tmp/projekt && mkdir -p /tmp/projekt
          unzip -o -q "$ZIP" -d /tmp/projekt
          # Projektordner finden (auch wenn die ZIP einen Unterordner enthaelt)
          WURZEL=$(dirname "$(find /tmp/projekt -type f -path '*/app/build.gradle' | head -1)")
          WURZEL=$(dirname "$WURZEL")
          if [ ! -f "$WURZEL/app/build.gradle" ]; then echo "In der ZIP fehlt app/build.gradle"; exit 1; fi
          echo "Projektordner: $WURZEL"
          echo "WURZEL=$WURZEL" >> "$GITHUB_ENV"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.10.2'

      - name: App bauen
        run: cd "$WURZEL" && gradle assembleRelease --no-daemon --stacktrace

      - name: Version lesen und APK benennen
        id: v
        run: |
          NAME=$(grep -oP "versionName '\K[^' ]+" "$WURZEL/app/build.gradle" | head -1)
          mkdir -p ausgabe
          cp "$WURZEL/app/build/outputs/apk/release/app-release.apk" "ausgabe/MaklerCockpit-Handy-v${NAME}.apk"
          echo "name=${NAME}" >> "$GITHUB_OUTPUT"

      - uses: actions/upload-artifact@v4
        with:
          name: MaklerCockpit-Handy-v${{ steps.v.outputs.name }}
          path: ausgabe/*.apk

      - name: Als Release zum Herunterladen bereitstellen
        uses: softprops/action-gh-release@v2
        with:
          tag_name: handy-v${{ steps.v.outputs.name }}-${{ github.run_number }}
          name: MaklerCockpit Handy v${{ steps.v.outputs.name }} (Lauf ${{ github.run_number }})
          files: ausgabe/*.apk
          body: Auf dem Handy die APK-Datei antippen und installieren. Updates einfach drueberinstallieren - die Daten bleiben.
